# Example Secret template - apply out-of-band or via sealed-secrets / external-secrets
# DO NOT commit real production passwords to git
apiVersion: v1
kind: Secret
metadata:
  name: buergerportal-secret
  labels:
    app.kubernetes.io/name: buergerportal
    app.kubernetes.io/part-of: buergerportal
type: Opaque
stringData:
  DATABASE_URL: "postgres://buergerportal:CHANGE_ME_PASSWORD@buergerportal-db:5432/buergerportal"
---
apiVersion: v1
kind: Secret
metadata:
  name: buergerportal-db-secret
  labels:
    app.kubernetes.io/name: buergerportal-db
    app.kubernetes.io/part-of: buergerportal
type: Opaque
stringData:
  database-user: "buergerportal"
  database-password: "CHANGE_ME_PASSWORD"
