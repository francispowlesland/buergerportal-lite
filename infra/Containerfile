# Build stage
FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS builder
WORKDIR /opt/app-root/src

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build && npm prune --omit=dev

# Production runtime stage
FROM registry.access.redhat.com/ubi9/nodejs-20-minimal:latest AS runner
WORKDIR /opt/app-root/src

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    BODY_SIZE_LIMIT=32M

COPY --from=builder --chown=1001:0 /opt/app-root/src/package*.json ./
COPY --from=builder --chown=1001:0 /opt/app-root/src/node_modules ./node_modules
COPY --from=builder --chown=1001:0 /opt/app-root/src/build ./build

# Support OpenShift arbitrary UID (member of root GID 0)
RUN chgrp -R 0 /opt/app-root/src && chmod -R g=u /opt/app-root/src

EXPOSE 8080
USER 1001

CMD ["node", "build/index.js"]
